# sudogate — lets __USER__ run ONLY the wrapper as root, without a password.
#
# The wrapper takes no command on its command line: it reads the command
# recorded for a nonce, re-classifies it with the root-owned patterns in
# /etc/sudogate/destructive.patterns and, when destructive, requires a valid
# TOTP checked against /etc/sudogate/seed (0400 root).
#
# Install at 0440 root:root. Files with wider permissions are ignored silently.
__USER__ ALL=(root) NOPASSWD: /usr/local/sbin/sudogate-run
