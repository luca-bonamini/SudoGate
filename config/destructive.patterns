# Destructive command patterns - these require TOTP in the root wrapper.
# One Python regex per line. Generated from sudogate/config.py DEFAULTS.
# Root-owned (0444): the unprivileged user cannot weaken this list.

\brm\s+(-\w+\s+)*-\w*(r\w*f|f\w*r)
\bdd\b
\bmkfs\b
\b(fdisk|parted)\b
\b(shutdown|reboot|poweroff|halt)\b
\b(passwd|usermod|useradd|userdel)\b
\b(visudo|sudoers)\b
/etc/netplan
\b(chown|chmod)\b.*\s-\w*R
\b(iptables|ufw|nft)\b
\bsystemctl\s+(disable|mask)\b
\bapt(-get)?\s+(remove|purge|autoremove)\b
\|\s*(ba)?sh\b
>\s*/dev/(sd|nvme|vd)
\btailscale\s+down\b
