#!/usr/bin/env python3
"""Wrapper executed as root: /usr/local/sbin/sudogate-run <token>

Reads the approved command for the token, re-classifies it as destructive
using the root-owned patterns, and when destructive verifies the TOTP that
came with the approval against the root-owned seed. Then runs it. Appends to
/var/log/sudogate/audit.log.

Everything this program trusts is owned by root or by the daemon account. The
library it imports and the policy files it reads are fixed paths under
/usr/local/lib and /etc: a wrapper that loaded its own enforcement code from a
directory the calling user can write would enforce nothing. The approved
record comes from /run/sudogate/approved, written by the daemon at 0700 under
the daemon's account, so the gated user can neither forge one nor read a
token. The record also names the uid that asked, which must match the uid sudo
escalated from.

Only when this runs unprivileged (tests, development) may the paths be
redirected through the environment. As root they are constants.
"""
import os
import pathlib
import pwd
import subprocess
import sys
import time

IS_ROOT = os.geteuid() == 0

LIB_DIR = pathlib.Path("/usr/local/lib/sudogate")
ETC_DIR = pathlib.Path("/etc/sudogate")
RUNTIME_DIR = pathlib.Path("/run/sudogate")
DAEMON_USER = "sudogate"


def _refuse(message):
    print(f"sudogate-run: {message}", file=sys.stderr)
    raise SystemExit(1)


def _assert_trusted(path, allowed_uids=(0,)):
    """Refuse unless path, and every directory above it, is owned by one of
    allowed_uids and writable by its owner alone.

    Cheap, and it keeps the property true after future changes to the
    installer: a library directory that became group-writable would otherwise
    be a silent way back to arbitrary code as root.
    """
    path = pathlib.Path(path)
    try:
        targets = [path.stat()] + [parent.stat() for parent in path.parents]
    except OSError as exc:
        _refuse(f"cannot verify {path}: {exc}")
    for component, info in zip([path] + list(path.parents), targets):
        if info.st_uid not in allowed_uids:
            _refuse(f"{component} is owned by uid {info.st_uid}, which is not trusted")
        if info.st_mode & 0o022:
            _refuse(f"{component} is writable by group or other")


def _assert_root_only(path):
    _assert_trusted(path, allowed_uids=(0,))


def _daemon_uid():
    try:
        return pwd.getpwnam(DAEMON_USER).pw_uid
    except KeyError:
        _refuse(f"the {DAEMON_USER} account does not exist; re-run install-root.sh")


def _assert_library_root_only(lib_dir):
    _assert_root_only(lib_dir)
    for source in sorted(lib_dir.rglob("*.py")):
        info = source.stat()
        if info.st_uid != 0 or info.st_mode & 0o022:
            _refuse(f"{source} is writable outside root")


def _invoking_uid():
    """uid sudo escalated from. The environment is scrubbed but SUDO_UID
    survives, and the kernel — not the caller — set it."""
    raw = os.environ.get("SUDO_UID")
    try:
        return int(raw)
    except (TypeError, ValueError):
        return None


if IS_ROOT:
    if not (LIB_DIR / "sudogate" / "__init__.py").is_file():
        _refuse(f"library not installed at {LIB_DIR}; re-run install-root.sh")
    _assert_library_root_only(LIB_DIR)
    sys.path.insert(0, str(LIB_DIR))
else:
    # Unprivileged: the checkout next to this script. Never a fixed path in
    # anyone's home, and never reachable from the root branch above.
    sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))

from sudogate import state, wrapper  # noqa: E402

if IS_ROOT:
    RUNTIME_HOME = RUNTIME_DIR
    PATTERNS_PATH = ETC_DIR / "destructive.patterns"
    SEED_PATH = ETC_DIR / "seed"
    ALWAYS_PATH = ETC_DIR / "totp_always"
    AUDIT_PATH = pathlib.Path("/var/log/sudogate/audit.log")
    _assert_root_only(ETC_DIR)
    _assert_trusted(RUNTIME_HOME / state.SUBDIR, allowed_uids=(0, _daemon_uid()))
else:
    RUNTIME_HOME = pathlib.Path(
        os.environ.get("SUDOGATE_RUNTIME_DIR") or RUNTIME_DIR
    )
    PATTERNS_PATH = os.environ.get("SUDOGATE_PATTERNS", str(ETC_DIR / "destructive.patterns"))
    SEED_PATH = os.environ.get("SUDOGATE_SEED", str(ETC_DIR / "seed"))
    ALWAYS_PATH = os.environ.get("SUDOGATE_TOTP_ALWAYS", str(ETC_DIR / "totp_always"))
    AUDIT_PATH = pathlib.Path(os.environ.get("SUDOGATE_AUDIT", "/var/log/sudogate/audit.log"))

CLAIM_TTL = 300


def _audit(line):
    try:
        AUDIT_PATH.parent.mkdir(parents=True, exist_ok=True)
        with AUDIT_PATH.open("a") as handle:
            handle.write(f"{int(time.time())}\t{line}\n")
        AUDIT_PATH.chmod(0o600)
    except OSError:
        pass


def main(argv):
    if not argv:
        print("usage: sudogate-run <token>", file=sys.stderr)
        return 2
    token = argv[0]
    now = time.time()

    record = state.claim(RUNTIME_HOME, token, now, CLAIM_TTL)
    if record is None:
        _audit("REJECT reason=invalid-or-already-used")
        print("token invalid, expired, or already used", file=sys.stderr)
        return 1

    # The approval was granted to one account. Another account holding the
    # token — it never reaches them through the gate — does not inherit it.
    caller = _invoking_uid()
    approved_for = record.get("uid")
    if approved_for is not None and caller is not None and caller != approved_for:
        _audit(f"DENY reason=uid-mismatch approved_for={approved_for} caller={caller}")
        print("this approval was issued to another account", file=sys.stderr)
        state.discard(RUNTIME_HOME, token)
        return 1

    command = record["command"]
    patterns = wrapper.load_patterns(PATTERNS_PATH)
    seed = wrapper.load_seed(SEED_PATH)
    always = wrapper.load_totp_always(ALWAYS_PATH)
    ok, reason = wrapper.authorize(command, patterns, seed, record.get("totp"), now, always)
    if not ok:
        _audit(f"DENY cmd={command!r} reason={reason}")
        print(reason, file=sys.stderr)
        state.discard(RUNTIME_HOME, token)
        return 1

    _audit(f"RUN cmd={command!r}")
    result = subprocess.run(command, shell=True)
    state.discard(RUNTIME_HOME, token)
    return result.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
