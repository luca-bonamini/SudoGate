#!/usr/bin/env python3
"""Wrapper executed as root: /usr/local/sbin/sudogate-run <nonce> [<totp>]

Reads the command from the state entry for the nonce, re-classifies it as
destructive using the root-owned patterns, and when destructive verifies the
TOTP against the root-owned seed. Then runs it. Appends to
/var/log/sudogate/audit.log.
"""
import os
import pathlib
import pwd
import subprocess
import sys
import time


def _invoking_user_home():
    """Home of the user who invoked the escalation, not root's.

    The environment is scrubbed but SUDO_USER survives. It is how the state
    and the user library are located without hard-coding any user name.
    """
    user = os.environ.get("SUDO_USER")
    if user:
        try:
            return pathlib.Path(pwd.getpwnam(user).pw_dir)
        except KeyError:
            pass
    return pathlib.Path.home()


USER_HOME = _invoking_user_home()

for _candidate in (
    pathlib.Path(__file__).resolve().parent.parent,
    USER_HOME / ".local" / "lib" / "sudogate",
):
    if (_candidate / "sudogate" / "__init__.py").is_file():
        sys.path.insert(0, str(_candidate))
        break

from sudogate import state, wrapper  # noqa: E402

STATE_HOME = pathlib.Path(
    os.environ.get("SUDOGATE_STATE_HOME") or (USER_HOME / ".config" / "sudogate")
)
PATTERNS_PATH = os.environ.get("SUDOGATE_PATTERNS", "/etc/sudogate/destructive.patterns")
SEED_PATH = os.environ.get("SUDOGATE_SEED", "/etc/sudogate/seed")
AUDIT_PATH = pathlib.Path(os.environ.get("SUDOGATE_AUDIT", "/var/log/sudogate/audit.log"))
CLAIM_TTL = 300


def _audit(line):
    try:
        AUDIT_PATH.parent.mkdir(parents=True, exist_ok=True)
        with AUDIT_PATH.open("a") as handle:
            handle.write(f"{int(time.time())}\t{line}\n")
        AUDIT_PATH.chmod(0o600)
    except OSError:
        pass


def main(argv):
    if not argv:
        print("usage: sudogate-run <nonce> [<totp>]", file=sys.stderr)
        return 2
    nonce = argv[0]
    totp_code = argv[1] if len(argv) > 1 else None
    now = time.time()

    record = state.claim(STATE_HOME, nonce, now, CLAIM_TTL)
    if record is None:
        _audit(f"REJECT nonce={nonce} reason=invalid-or-already-used")
        print("nonce invalid, expired, or already used", file=sys.stderr)
        return 1

    command = record["command"]
    patterns = wrapper.load_patterns(PATTERNS_PATH)
    seed = wrapper.load_seed(SEED_PATH)
    ok, reason = wrapper.authorize(command, patterns, seed, totp_code, now)
    if not ok:
        _audit(f"DENY cmd={command!r} reason={reason}")
        print(reason, file=sys.stderr)
        return 1

    _audit(f"RUN cmd={command!r}")
    result = subprocess.run(command, shell=True)
    state_path = STATE_HOME / "state" / f"{nonce}.json"
    try:
        state_path.unlink(missing_ok=True)
    except OSError:
        pass
    return result.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
