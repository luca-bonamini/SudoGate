#!/usr/bin/env python3
"""Capture the chat id: ask for the token, wait for a message, write config.json."""
import getpass
import pathlib
import sys
import time

def _add_package_to_path():
    """Locate the sudogate package: next to the script first (repo or plugin
    checkout), then in the user's installed library."""
    here = pathlib.Path(__file__).resolve().parent
    for candidate in (here.parent, pathlib.Path.home() / ".local" / "lib" / "sudogate"):
        if (candidate / "sudogate" / "__init__.py").is_file():
            sys.path.insert(0, str(candidate))
            return


_add_package_to_path()

from sudogate import bootstrap, config, telegram  # noqa: E402

ATTEMPTS = 20


def main():
    token = getpass.getpass("Bot token (input hidden): ").strip()
    if not token:
        print("empty token, aborted")
        return 1
    client = telegram.Client(token)
    print("Send /start to the bot from Telegram. Waiting.")
    for _ in range(ATTEMPTS):
        try:
            updates = client.get_updates(offset=0, timeout=15)
        except telegram.TelegramError as exc:
            print(f"error: {exc}")
            return 1
        chat_id = bootstrap.first_chat_id(updates)
        if chat_id is not None:
            path = config.config_path()
            bootstrap.write_config(path, token, chat_id)
            print(f"chat_id {chat_id} written to {path}")
            return 0
        time.sleep(1)
    print("no message received, try again")
    return 1


if __name__ == "__main__":
    sys.exit(main())
