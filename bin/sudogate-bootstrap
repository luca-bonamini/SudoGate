#!/usr/bin/env python3
"""Cattura il chat_id: chiede il token, attende un messaggio al bot, scrive config.json."""
import getpass
import pathlib
import sys
import time

def _add_package_to_path():
    """Trova il package sudogate: prima accanto allo script (repo o plugin),
    poi nella libreria installata dell'utente."""
    here = pathlib.Path(__file__).resolve().parent
    for candidate in (here.parent, pathlib.Path.home() / ".local" / "lib" / "sudogate"):
        if (candidate / "sudogate" / "__init__.py").is_file():
            sys.path.insert(0, str(candidate))
            return


_add_package_to_path()

from sudogate import bootstrap, config, telegram  # noqa: E402

ATTEMPTS = 20


def main():
    token = getpass.getpass("Token del bot (non viene mostrato): ").strip()
    if not token:
        print("token vuoto, interrotto")
        return 1
    client = telegram.Client(token)
    print("Manda /start al bot da Telegram. Attendo.")
    for _ in range(ATTEMPTS):
        try:
            updates = client.get_updates(offset=0, timeout=15)
        except telegram.TelegramError as exc:
            print(f"errore: {exc}")
            return 1
        chat_id = bootstrap.first_chat_id(updates)
        if chat_id is not None:
            path = config.config_path()
            bootstrap.write_config(path, token, chat_id)
            print(f"chat_id {chat_id} scritto in {path}")
            return 0
        time.sleep(1)
    print("nessun messaggio ricevuto, riprova")
    return 1


if __name__ == "__main__":
    sys.exit(main())
