#!/usr/bin/env python3
"""Generate the TOTP seed, show the QR, and leave a temporary file.

Runs as the normal user. It does not write to /etc: it prints the secret
once, the QR (qrencode when available, otherwise the otpauth URI), and
writes the secret to /tmp/sudogate-seed (0600), which install-root.sh moves
to /etc/sudogate/seed 0400 root. Delete the temporary file afterwards.
"""
import pathlib
import shutil
import socket
import subprocess
import sys

def _add_package_to_path():
    """Locate the sudogate package: next to the script first (repo or plugin
    checkout), then in the user's installed library."""
    here = pathlib.Path(__file__).resolve().parent
    for candidate in (here.parent, pathlib.Path.home() / ".local" / "lib" / "sudogate"):
        if (candidate / "sudogate" / "__init__.py").is_file():
            sys.path.insert(0, str(candidate))
            return


_add_package_to_path()

from sudogate import totp  # noqa: E402

TEMP = pathlib.Path("/tmp/sudogate-seed")


def main():
    secret = totp.new_secret()
    uri = totp.provisioning_uri(secret, label=socket.gethostname(), issuer="sudogate")
    print("TOTP secret (shown once, and only once):")
    print(f"  {secret}\n")
    if shutil.which("qrencode"):
        print("Scan this QR with your authenticator app:\n")
        subprocess.run(["qrencode", "-t", "ANSI", uri])
    else:
        print("qrencode not found. Enter this URI in your authenticator by hand:")
        print(f"  {uri}")
    TEMP.write_text(secret)
    TEMP.chmod(0o600)
    print(f"\nSecret written to {TEMP} (0600).")
    print("Ora esegui:  sudo ./install-root.sh")
    print("Then delete the temporary file:  shred -u /tmp/sudogate-seed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
