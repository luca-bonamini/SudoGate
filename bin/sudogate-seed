#!/usr/bin/env python3
"""Genera il seed TOTP del gate, mostra il QR e lascia un file temporaneo.

Gira come luca. NON scrive in /etc: stampa il segreto una volta, il QR
(qrencode se presente, altrimenti l'URI otpauth), e scrive il segreto in
/tmp/sudogate-seed (0600) che install-root.sh sposta come root a
/etc/sudogate/seed 0400 root. Dopo l'installazione, cancella il temp.
"""
import pathlib
import shutil
import socket
import subprocess
import sys

def _add_package_to_path():
    """Trova il package sudogate: prima accanto allo script (repo o plugin),
    poi nella libreria installata dell'utente."""
    here = pathlib.Path(__file__).resolve().parent
    for candidate in (here.parent, pathlib.Path.home() / ".local" / "lib" / "sudogate"):
        if (candidate / "sudogate" / "__init__.py").is_file():
            sys.path.insert(0, str(candidate))
            return


_add_package_to_path()

from sudogate import totp  # noqa: E402

TEMP = pathlib.Path("/tmp/sudogate-seed")


def main():
    secret = totp.new_secret()
    uri = totp.provisioning_uri(secret, label=socket.gethostname(), issuer="sudogate")
    print("Segreto TOTP (mostrato una volta sola):")
    print(f"  {secret}\n")
    if shutil.which("qrencode"):
        print("Scansiona questo QR con l'app authenticator:\n")
        subprocess.run(["qrencode", "-t", "ANSI", uri])
    else:
        print("qrencode assente. Inserisci a mano questo URI nell'authenticator:")
        print(f"  {uri}")
    TEMP.write_text(secret)
    TEMP.chmod(0o600)
    print(f"\nSegreto scritto in {TEMP} (0600).")
    print("Ora esegui:  sudo ./install-root.sh")
    print("Poi cancella il temp:  shred -u /tmp/sudogate-seed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
