#!/usr/bin/env python3
"""PreToolUse hook (Bash matcher): denies direct escalation, requires the shim.

The real approval happens in the shim. This hook only prevents the shim from
being bypassed. Exits 0 with no decision when the command is unrelated.
"""
import json
import pathlib
import sys

def _add_package_to_path():
    """Locate the sudogate package: next to the script first (repo or plugin
    checkout), then in the user's installed library."""
    here = pathlib.Path(__file__).resolve().parent
    for candidate in (here.parent, pathlib.Path.home() / ".local" / "lib" / "sudogate"):
        if (candidate / "sudogate" / "__init__.py").is_file():
            sys.path.insert(0, str(candidate))
            return


_add_package_to_path()


def main():
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw)
    except ValueError:
        return 0
    command = (payload.get("tool_input") or {}).get("command", "")
    try:
        from sudogate import gate
    except Exception:  # noqa: BLE001
        return 0
    if not gate.contains_sudo(command):
        return 0
    out = {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": "Use: sudogate <command>. The gate asks for approval on Telegram.",
        }
    }
    print(json.dumps(out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
