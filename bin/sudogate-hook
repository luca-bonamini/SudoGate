#!/usr/bin/env python3
"""Hook PreToolUse (matcher Bash): nega sudo diretto, impone sudogate.

L'approvazione vera avviene nello shim. Questo hook serve solo a impedire
che sudo venga invocato scavalcando lo shim. Esce 0 (nessuna decisione)
quando il comando non contiene sudo.
"""
import json
import pathlib
import sys

def _add_package_to_path():
    """Trova il package sudogate: prima accanto allo script (repo o plugin),
    poi nella libreria installata dell'utente."""
    here = pathlib.Path(__file__).resolve().parent
    for candidate in (here.parent, pathlib.Path.home() / ".local" / "lib" / "sudogate"):
        if (candidate / "sudogate" / "__init__.py").is_file():
            sys.path.insert(0, str(candidate))
            return


_add_package_to_path()


def main():
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw)
    except ValueError:
        return 0
    command = (payload.get("tool_input") or {}).get("command", "")
    try:
        from sudogate import gate
    except Exception:  # noqa: BLE001
        return 0
    if not gate.contains_sudo(command):
        return 0
    out = {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": "Usa: sudogate <comando> (senza sudo). Il gate chiede approvazione su Telegram.",
        }
    }
    print(json.dumps(out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
