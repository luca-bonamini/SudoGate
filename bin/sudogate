#!/usr/bin/env python3
"""Shim that Claude Code uses instead of escalating privileges directly.

Usage: sudogate <command...>
Asks the gate bot for approval (a button, plus a TOTP code when the command
is destructive), then runs it through the root wrapper. Commands that are
not destructive and were approved recently skip the button, thanks to the
cache.
"""
import os
import pathlib
import subprocess
import sys
import time

def _add_package_to_path():
    """Locate the sudogate package: next to the script first (repo or plugin
    checkout), then in the user's installed library."""
    here = pathlib.Path(__file__).resolve().parent
    for candidate in (here.parent, pathlib.Path.home() / ".local" / "lib" / "sudogate"):
        if (candidate / "sudogate" / "__init__.py").is_file():
            sys.path.insert(0, str(candidate))
            return


_add_package_to_path()

from sudogate import cache, config, gate, sessions, state  # noqa: E402
from sudogate import ipc  # noqa: E402

WRAPPER = "/usr/local/sbin/sudogate-run"


def main(argv):
    command = " ".join(argv).strip()
    if not command:
        print("usage: sudogate <command>", file=sys.stderr)
        return 2
    try:
        cfg = config.load()
    except config.ConfigError as exc:
        print(f"gate not configured: {exc}", file=sys.stderr)
        return 1

    home = config.home()
    cwd = os.getcwd()
    now = time.time()
    destructive = gate.is_destructive(command, cfg["destructive_patterns"])
    cache_path = home / "cache.json"
    label = sessions.label_for_cwd(cwd, sessions.tmux_sessions())

    nonce = state.create(home, command, cwd, label, now)

    if not destructive and cache.is_approved(cache_path, cwd, command, now):
        return _run_wrapper(nonce, None)

    payload = {"nonce": nonce, "command": command, "cwd": cwd,
               "label": label, "destructive": destructive}
    timeout = cfg.get("approval_ttl_seconds", 120) + 15
    try:
        reply = ipc.request(home / "gate.sock", payload, timeout=timeout)
    except ipc.IPCError as exc:
        print(f"gate unreachable, command denied: {exc}", file=sys.stderr)
        return 1

    if reply.get("verdict") != "approve":
        print(f"denied: {reply.get('reason', 'no reason given')}", file=sys.stderr)
        return 1

    if not destructive:
        cache.remember(cache_path, cwd, command, now, cfg.get("cache_ttl_seconds", 28800))

    return _run_wrapper(nonce, reply.get("totp"))


def _run_wrapper(nonce, totp_code):
    args = ["sudo", WRAPPER, nonce]
    if totp_code:
        args.append(totp_code)
    return subprocess.run(args).returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
