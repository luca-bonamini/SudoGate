#!/usr/bin/env python3
"""Shim that Claude Code uses instead of escalating privileges directly.

Usage: sudogate <command...>

It carries the command to the gate daemon and, if the daemon returns a token,
runs the wrapper with it. That is all it does. It does not decide whether a
command is destructive, it does not keep the approval cache, and it never
handles the TOTP code — it runs as the account the gate exists to constrain,
so anything it decided would be a decision the caller could make for itself.
"""
import os
import pathlib
import subprocess
import sys

def _add_package_to_path():
    """Locate the sudogate package: next to the script first (repo or plugin
    checkout), then in the user's installed library."""
    here = pathlib.Path(__file__).resolve().parent
    for candidate in (here.parent, pathlib.Path.home() / ".local" / "lib" / "sudogate"):
        if (candidate / "sudogate" / "__init__.py").is_file():
            sys.path.insert(0, str(candidate))
            return


_add_package_to_path()

from sudogate import config, gate, ipc, sessions  # noqa: E402

WRAPPER = "/usr/local/sbin/sudogate-run"
REQUEST_TIMEOUT = 180


def main(argv):
    command = gate.compose_command(argv)
    if not command:
        print("usage: sudogate <command>", file=sys.stderr)
        return 2

    cwd = os.getcwd()
    label = sessions.label_for_cwd(cwd, sessions.tmux_sessions())
    payload = {"command": command, "cwd": cwd, "label": label}

    try:
        reply = ipc.request(config.socket_path(), payload, timeout=REQUEST_TIMEOUT)
    except ipc.IPCError as exc:
        print(f"gate unreachable, command denied: {exc}", file=sys.stderr)
        return 1

    if reply.get("verdict") != "approve" or not reply.get("token"):
        print(f"denied: {reply.get('reason', 'no reason given')}", file=sys.stderr)
        return 1

    return subprocess.run(["sudo", WRAPPER, reply["token"]]).returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
