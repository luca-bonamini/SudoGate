#!/usr/bin/env python3
"""Hook PreToolUse (matcher Bash): nega sudo diretto, impone claude-sudo.

L'approvazione vera avviene nello shim. Questo hook serve solo a impedire
che sudo venga invocato scavalcando lo shim. Esce 0 (nessuna decisione)
quando il comando non contiene sudo.
"""
import json
import pathlib
import sys

REPO_LIB = pathlib.Path("/home/luca/.local/lib/claude-telegram")
if REPO_LIB.is_dir():
    sys.path.append(str(REPO_LIB))


def main():
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw)
    except ValueError:
        return 0
    command = (payload.get("tool_input") or {}).get("command", "")
    try:
        from ctg import gate
    except Exception:  # noqa: BLE001
        return 0
    if not gate.contains_sudo(command):
        return 0
    out = {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": "Usa: claude-sudo <comando> (senza sudo). Il gate chiede approvazione su Telegram.",
        }
    }
    print(json.dumps(out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
